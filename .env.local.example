# Copy this file to .env.local for local development only.
# Do not commit .env.local.

# ---------- Supabase (required) ----------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # bypasses RLS — keep secret

# ---------- AI Provider (pick ONE) ----------
# Option A: Anthropic (default)
ANTHROPIC_API_KEY=sk-ant-...
AI_PROVIDER=anthropic
AI_MODEL=claude-sonnet-4-5

# Option B: OpenAI
# OPENAI_API_KEY=sk-...
# AI_PROVIDER=openai
# AI_MODEL=gpt-4o-mini

# ---------- Paper Trading (required for /trade) ----------
# Get a free API key at https://finnhub.io
FINNHUB_API_KEY=your-finnhub-api-key

# ---------- Email (required for streak reminders) ----------
# Get an API key at https://resend.com
RESEND_API_KEY=re_...
RESEND_FROM=Vanetex <reminders@yourdomain.com>   # must be a verified Resend domain

# ---------- Cron security (required) ----------
# Random secret used to authenticate /api/cron/* routes.
# Set the same value in Vercel → Settings → Environment Variables.
# Add it to vercel.json cron headers: { "Authorization": "Bearer <value>" }
CRON_SECRET=your-random-secret-here

# ---------- Site URL (optional but recommended) ----------
# Used in emails and OG tags. Defaults to https://vanetex.vercel.app if unset.
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# ---------- Push notifications (required for PWA push) ----------
# Generate once with: npx web-push generate-vapid-keys
# Public key is exposed to the client; private key is server-only.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
